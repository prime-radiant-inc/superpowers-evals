#!/usr/bin/env bash
# quorum-generated launcher for Google Antigravity (the agent under test).
#
# The cd, throwaway-$HOME pin, ANTIGRAVITY_CONFIG_DIR, explicit --gemini_dir,
# auto-update disable, and dangerous-mode flag are baked in here so the QA agent
# starts agy from the prepared workdir with one command. quorum substitutes the
# $... values below at runtime; the installed copy contains literal absolute
# paths. When the real workdir path contains a hidden component, $QUORUM_AGENT_CWD
# may be a visible symlink to that workdir so Antigravity accepts it as a
# workspace.
#
# Throwaway $HOME: $QUORUM_HOME_ENV pins HOME (+XDG +TMPDIR) to the per-run home
# (= $QUORUM_AGENT_HOME) so agy cannot read/write the operator's real ~/.gemini,
# ~/.config, etc. With antigravity.yaml's home_config_subdir ".", the config dir
# IS that home ($QUORUM_AGENT_HOME), so $QUORUM_AGENT_HOME/.gemini is the single
# dir where provisioning seeds the plugin, settings, AND the C1 OAuth creds.
#
# CRITICAL (C1): agy reads its runtime credential from
# $HOME/.gemini/antigravity-cli/antigravity-oauth-token at RUNTIME, NOT via
# --gemini_dir. Because HOME is the throwaway home, that read would miss the
# operator's token unless provisioning copied it in — which it does
# (seedAgyOauthCredentials in src/agents/antigravity.ts), failing before
# launch if the source token cannot be seeded (F13: agy must never reach the
# operator's per-login-user keyring). The flat oauth_creds.json /
# google_accounts.json are the incidental Gemini-personal layout — copied when
# present, but they do not authenticate agy.
#
# --gemini_dir stays EXPLICIT: it relocates agy's STATE tree (config, plugins,
# antigravity-cli/{settings,brain}). It already resolves to the throwaway
# home's .gemini (the same dir HOME would default to), so it is belt-and-braces,
# not load-bearing for relocation here — but keep it pinned to a known path so a
# future HOME-default change can't silently move the state tree. (FLAGGED: a
# live agy smoke is required before dropping it, even though empirically agy
# defaults --gemini_dir to $HOME/.gemini when omitted.)
#
# Equivalent manual command (for debugging) — a sketch, not literal bash (the
# real invocation is the env -i wall below):
#   cd "$QUORUM_AGENT_CWD" && env -i PATH="$PATH" TERM="${TERM:-xterm-256color}" LANG="${LANG:-C.UTF-8}" \
#     HOME="$QUORUM_AGENT_HOME" <XDG+TMPDIR pins> ANTIGRAVITY_CONFIG_DIR="$QUORUM_AGENT_HOME" AGY_CLI_DISABLE_AUTO_UPDATE=true \
#     agy --gemini_dir="$QUORUM_AGENT_HOME/.gemini" --add-dir="$QUORUM_AGENT_CWD" --dangerously-skip-permissions --log-file "$QUORUM_AGENT_HOME/agy.log"
set -euo pipefail
cd "$QUORUM_AGENT_CWD" || { echo "launch-agent: cannot cd to $QUORUM_AGENT_CWD" >&2; exit 1; }
# Host-env isolation (F13): env -i + explicit allowlist. agy reads its OAuth
# creds from the throwaway home's .gemini (seeded by provisioning) — nothing
# secret rides the environment.
env_args=(
  "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
  "TERM=${TERM:-xterm-256color}"
  "LANG=${LANG:-C.UTF-8}"
)

exec env -i \
  "${env_args[@]}" \
  $QUORUM_HOME_ENV \
  ANTIGRAVITY_CONFIG_DIR="$QUORUM_AGENT_HOME" \
  AGY_CLI_DISABLE_AUTO_UPDATE=true \
  agy \
    --gemini_dir="$QUORUM_AGENT_HOME/.gemini" \
    --add-dir="$QUORUM_AGENT_CWD" \
    --dangerously-skip-permissions \
    --log-file "$QUORUM_AGENT_HOME/agy.log" \
    "$@"
