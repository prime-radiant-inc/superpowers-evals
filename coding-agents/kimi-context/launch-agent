#!/usr/bin/env bash
# quorum-generated launcher for Kimi Code (the agent under test).
#
# Throwaway $HOME: $QUORUM_HOME_ENV pins HOME (+XDG +TMPDIR) to the per-run home,
# and kimi.yaml's home_config_subdir ".kimi-code" makes the config dir
# $HOME/.kimi-code — where provisioning seeded kimi's config + host OAuth creds.
# kimi finds it via the $HOME default, so the launcher sets NO KIMI_CODE_HOME.
# The sourced env file carries only the model env + the ~/.kimi-code/bin PATH
# prepend (so the engine binary resolves); $QUORUM_HOME_ENV's HOME assignment
# overrides whatever the inherited env had. The env file (which holds the mode-
# 0600 model API key) is sourced then deleted so capture never snapshots it.
set -euo pipefail

cleanup_kimi_env() {
  rm -f "$KIMI_ENV_FILE"
}
trap cleanup_kimi_env EXIT HUP INT TERM

cd "$QUORUM_AGENT_CWD" || {
  echo "launch-agent: cannot cd to $QUORUM_AGENT_CWD" >&2
  exit 1
}

# The trusted env file OWNS every name below (SYNC: it is allowlist-built by
# buildKimiSubprocessEnv, src/agents/kimi.ts, whose finite host passthrough +
# model env must match this list exactly — one intentional producer+consumer
# change per addition). PATH/TERM/LANG are the base-trio exception: the file
# also sets them, but they forward with launch-time fallbacks like every other
# converted launcher. Drop inherited values before sourcing so a file-omitted
# name (e.g. KIMI_MODEL_API_KEY in OAuth mode) stays absent — omission stays
# omission, and a hostile host export can never ride the forward below.
kimi_file_vars=(
  SHELL LC_ALL LC_CTYPE
  http_proxy https_proxy all_proxy no_proxy
  HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
  KIMI_MODEL_NAME KIMI_MODEL_PROVIDER_TYPE KIMI_MODEL_BASE_URL
  KIMI_MODEL_MAX_CONTEXT_SIZE KIMI_MODEL_CAPABILITIES
  KIMI_MODEL_DEFAULT_THINKING KIMI_MODEL_API_KEY
  KIMI_DISABLE_TELEMETRY KIMI_DISABLE_CRON
  KIMI_CODE_BACKGROUND_KEEP_ALIVE_ON_EXIT
)
unset "${kimi_file_vars[@]}"

set -a
. "$KIMI_ENV_FILE"
set +a
cleanup_kimi_env
trap - EXIT HUP INT TERM
unset KIMI_ENV_FILE
unset -f cleanup_kimi_env

# Host-env isolation (F13): env -i + explicit allowlist. Only names the
# sourced file actually set survive the pre-source unset above, so this loop
# forwards exactly the file's values.
env_args=(
  "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
  "TERM=${TERM:-xterm-256color}"
  "LANG=${LANG:-C.UTF-8}"
)
for name in "${kimi_file_vars[@]}"; do
  if [[ -n "${!name-}" ]]; then
    env_args+=("$name=${!name}")
  fi
done

exec env -i \
  "${env_args[@]}" \
  $QUORUM_HOME_ENV \
  $KIMI_BINARY --yolo "$@"
