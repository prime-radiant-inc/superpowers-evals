#!/usr/bin/env bash
# quorum-generated launcher for Kimi Code (the agent under test).
#
# Throwaway $HOME: $QUORUM_HOME_ENV pins HOME (+XDG +TMPDIR) to the per-run home,
# and kimi.yaml's home_config_subdir ".kimi-code" makes the config dir
# $HOME/.kimi-code — where provisioning seeded kimi's config + host OAuth creds.
# kimi finds it via the $HOME default, so the launcher sets NO KIMI_CODE_HOME.
# The sourced env file carries only the model env + the ~/.kimi-code/bin PATH
# prepend (so the engine binary resolves); $QUORUM_HOME_ENV's HOME assignment
# overrides whatever the inherited env had. The env file (which holds the mode-
# 0600 model API key) is sourced then deleted so capture never snapshots it.
set -euo pipefail

cleanup_kimi_env() {
  rm -f "$KIMI_ENV_FILE"
}
trap cleanup_kimi_env EXIT HUP INT TERM

cd "$QUORUM_AGENT_CWD" || {
  echo "launch-agent: cannot cd to $QUORUM_AGENT_CWD" >&2
  exit 1
}

set -a
. "$KIMI_ENV_FILE"
set +a
cleanup_kimi_env
trap - EXIT HUP INT TERM
unset KIMI_ENV_FILE
unset -f cleanup_kimi_env

# Host-env isolation (F13): env -i + explicit allowlist. The env file is
# allowlist-built by buildKimiSubprocessEnv (src/agents/kimi.ts) and already
# sourced above (and deleted); forward exactly those names — keep this list in
# sync with that builder: the forward list must name every var that file can
# set. The base trio covers the builder's PATH/TERM/LANG passthrough; the
# builder's open-ended LC_*/*_proxy host passthrough is frozen here to the
# standard names (bash 3.2 has no safe prefix expansion) — an exotic host
# locale/proxy name is dropped at the wall, never leaked.
env_args=(
  "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
  "TERM=${TERM:-xterm-256color}"
  "LANG=${LANG:-C.UTF-8}"
)
for name in SHELL LC_ALL LC_CTYPE \
  http_proxy https_proxy all_proxy no_proxy \
  HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY \
  KIMI_MODEL_NAME KIMI_MODEL_PROVIDER_TYPE KIMI_MODEL_BASE_URL \
  KIMI_MODEL_MAX_CONTEXT_SIZE KIMI_MODEL_CAPABILITIES \
  KIMI_MODEL_DEFAULT_THINKING KIMI_MODEL_API_KEY \
  KIMI_DISABLE_TELEMETRY KIMI_DISABLE_CRON \
  KIMI_CODE_BACKGROUND_KEEP_ALIVE_ON_EXIT; do
  if [[ -n "${!name-}" ]]; then
    env_args+=("$name=${!name}")
  fi
done

exec env -i \
  "${env_args[@]}" \
  $QUORUM_HOME_ENV \
  $KIMI_BINARY --yolo "$@"
