#!/usr/bin/env bash
set -euo pipefail

umask 077

# Select the OAuth home variables for one projected auth root ($1): unset
# EVERY auth-home variable first — a hostile inherited or env-file-injected
# value must never survive an absent mount — then export only the variables
# whose projected mount actually exists. Sourceable so the selection is
# behavior-testable on the host.
quorum_select_auth_env() {
  local auth_root=$1

  unset CODEX_AUTH_HOME GEMINI_OAUTH_HOME AGY_OAUTH_HOME KIMI_OAUTH_HOME PI_OAUTH_HOME

  if [[ -d "$auth_root/codex" ]]; then
    export CODEX_AUTH_HOME="$auth_root/codex"
  fi

  if [[ -d "$auth_root/gemini" ]]; then
    export GEMINI_OAUTH_HOME="$auth_root/gemini"
    export AGY_OAUTH_HOME="$auth_root/gemini"
  fi

  if [[ -d "$auth_root/kimi-code" ]]; then
    export KIMI_OAUTH_HOME="$auth_root/kimi-code"
  fi

  if [[ -d "$auth_root/pi" ]]; then
    export PI_OAUTH_HOME="$auth_root/pi"
  fi
}

# The launch flow runs only when the shim is executed, not sourced.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  cd /workspace/evals

  if [[ -f /run/evals/credentials.env ]]; then
    set -a
    # shellcheck disable=SC1091
    source /run/evals/credentials.env
    set +a
  fi

  export SUPERPOWERS_ROOT=/workspace/superpowers

  # AFTER the credentials env is sourced, so an env-file-injected OAuth home
  # is cleared too; only genuinely projected mounts survive.
  quorum_select_auth_env /auth

  export KIMI_BINARY=/usr/local/bin/kimi

  exec bun run src/cli/index.ts "$@"
fi
