#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: scripts/evals-container [options] <build|up|down|status|shell|exec> [args...]

options:
  --name <name>
  --superpowers-root <dir>
  --gauntlet-root <dir>
  --env-file <file>
  --auth <codex|gemini|kimi|pi>=<dir>
  --no-default-auth                (up: no host-home fallbacks; requires --env-file)
  --expected-container-id <id>   (exec only)
  --exec-env-file <file>         (exec only, requires --expected-container-id)
USAGE
}

die() {
  printf 'evals-container: %s\n' "$*" >&2
  exit 1
}

# Validate an absolute file path component by component WITHOUT following
# symlinks: every ancestor component must be a real directory (not a
# symlink, not '.'/'..'), and the final component must additionally be a
# regular readable file. A final-component-only -L check would let an
# intermediate symlink redirect the read, so the whole chain is walked.
validate_no_follow_file() {
  local path=$1 label=$2 component rest path_so_far
  [[ "$path" == /* ]] || die "$label must be an absolute path: $path"
  rest=${path#/}
  while [[ -n "$rest" ]]; do
    component=${rest%%/*}
    if [[ "$component" == "$rest" ]]; then
      rest=""
    else
      rest=${rest#*/}
    fi
    [[ -n "$component" && "$component" != "." && "$component" != ".." ]] \
      || die "$label has an unsafe path component: $path"
    path_so_far="$path_so_far/$component"
    [[ ! -L "$path_so_far" ]] \
      || die "$label reaches a symlink component: $path_so_far"
  done
  [[ -f "$path" ]] || die "$label is not a regular file: $path"
  [[ -r "$path" ]] || die "$label is not readable: $path"
}

physical_dir() {
  (cd "$1" && pwd -P)
}

physical_file() {
  local parent basename
  parent=$(dirname "$1")
  basename=$(basename "$1")
  printf '%s/%s\n' "$(cd "$parent" && pwd -P)" "$basename"
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
evals_root=$(cd "$script_dir/.." && pwd -P)
image_tag="superpowers-evals:local"

container_name=""
superpowers_root=""
superpowers_root_explicit=false
gauntlet_root=""
gauntlet_root_explicit=false
env_file=""
env_file_explicit=false

auth_codex=""
auth_gemini=""
auth_kimi=""
auth_pi=""
auth_codex_explicit=false
auth_gemini_explicit=false
auth_kimi_explicit=false
auth_pi_explicit=false

# Scoped mode (F13): --no-default-auth disables every host-home auth
# fallback during up; --expected-container-id binds exec to one immutable
# container id captured from `docker run`; --exec-env-file passes the
# supervisor env file through `docker exec --env-file` (process-local).
no_default_auth=false
expected_container_id=""
exec_env_file=""

parse_auth() {
  local spec name dir
  spec=$1
  name=${spec%%=*}
  dir=${spec#*=}

  if [[ "$name" == "$spec" || -z "$dir" ]]; then
    die "expected --auth <codex|gemini|kimi|pi>=<dir>"
  fi

  case "$name" in
    codex)
      auth_codex=$dir
      auth_codex_explicit=true
      ;;
    gemini)
      auth_gemini=$dir
      auth_gemini_explicit=true
      ;;
    kimi)
      auth_kimi=$dir
      auth_kimi_explicit=true
      ;;
    pi)
      auth_pi=$dir
      auth_pi_explicit=true
      ;;
    *)
      die "unsupported auth mount: $name"
      ;;
  esac
}

command=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name)
      [[ $# -ge 2 ]] || die "missing value for --name"
      container_name=$2
      shift 2
      ;;
    --superpowers-root)
      [[ $# -ge 2 ]] || die "missing value for --superpowers-root"
      superpowers_root=$2
      superpowers_root_explicit=true
      shift 2
      ;;
    --gauntlet-root)
      [[ $# -ge 2 ]] || die "missing value for --gauntlet-root"
      gauntlet_root=$2
      gauntlet_root_explicit=true
      shift 2
      ;;
    --env-file)
      [[ $# -ge 2 ]] || die "missing value for --env-file"
      env_file=$2
      env_file_explicit=true
      shift 2
      ;;
    --auth)
      [[ $# -ge 2 ]] || die "missing value for --auth"
      parse_auth "$2"
      shift 2
      ;;
    --no-default-auth)
      no_default_auth=true
      shift
      ;;
    --expected-container-id)
      [[ $# -ge 2 ]] || die "missing value for --expected-container-id"
      [[ -n "$2" ]] || die "empty value for --expected-container-id"
      expected_container_id=$2
      shift 2
      ;;
    --exec-env-file)
      [[ $# -ge 2 ]] || die "missing value for --exec-env-file"
      [[ -n "$2" ]] || die "empty value for --exec-env-file"
      exec_env_file=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      [[ $# -gt 0 ]] || die "missing command"
      command=$1
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      command=$1
      shift
      break
      ;;
  esac
done

[[ -n "$command" ]] || die "missing command"

case "$command" in
  build|up|down|status|shell|exec)
    ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac

if [[ "$command" != exec && $# -gt 0 ]]; then
  die "unexpected argument after $command: $1 (put options before the command)"
fi

# Scoped-exec flag validation: both flags are exec-only, --exec-env-file
# additionally requires the immutable id and must be an absolute, readable,
# regular file reached WITHOUT following a symlink (every component
# no-follow). All of this happens before any Docker call.
if [[ -n "$expected_container_id" || -n "$exec_env_file" ]]; then
  [[ "$command" == exec ]] || die "--expected-container-id and --exec-env-file are valid only for exec"
fi
if [[ -n "$exec_env_file" ]]; then
  [[ -n "$expected_container_id" ]] || die "--exec-env-file requires --expected-container-id"
  validate_no_follow_file "$exec_env_file" "--exec-env-file"
fi

# Scoped up must never silently discover a repo-default credential env
# file: --no-default-auth requires the caller to pass --env-file explicitly
# (the appliance always passes the projected active agent.env).
if [[ "$command" == up && "$no_default_auth" == true && "$env_file_explicit" != true ]]; then
  die "--no-default-auth requires an explicit --env-file; scoped up never discovers repo-default credential env files"
fi

if [[ -z "$container_name" ]]; then
  # shasum ships with macOS; Linux images generally carry only sha1sum.
  if command -v shasum >/dev/null 2>&1; then
    sha1_cmd=shasum
  elif command -v sha1sum >/dev/null 2>&1; then
    sha1_cmd=sha1sum
  else
    die "need shasum or sha1sum to derive a container name (or pass --container-name)"
  fi
  root_hash=$(printf '%s' "$evals_root" | "$sha1_cmd" | awk '{print substr($1,1,12)}')
  container_name="superpowers-evals-$root_hash"
fi

if [[ -z "$superpowers_root" ]]; then
  superpowers_root=$(cd "$evals_root/.." && pwd -P)
else
  [[ -d "$superpowers_root" ]] || die "superpowers root does not exist: $superpowers_root"
  superpowers_root=$(physical_dir "$superpowers_root")
fi

default_gauntlet_root() {
  if [[ -n "${GAUNTLET_ROOT:-}" ]]; then
    printf '%s\n' "$GAUNTLET_ROOT"
    return 0
  fi

  if [[ -d "$HOME/.bun/install/global/node_modules/gauntlet" ]]; then
    printf '%s\n' "$HOME/.bun/install/global/node_modules/gauntlet"
    return 0
  fi

  return 1
}

resolve_gauntlet_root() {
  if [[ "$gauntlet_root_explicit" != true ]]; then
    gauntlet_root=$(default_gauntlet_root || true)
  fi

  [[ -n "$gauntlet_root" ]] || die "Gauntlet root not found; set GAUNTLET_ROOT or pass --gauntlet-root"
  [[ -d "$gauntlet_root" ]] || die "Gauntlet root does not exist: $gauntlet_root"
  gauntlet_root=$(physical_dir "$gauntlet_root")
  [[ -f "$gauntlet_root/package.json" ]] || die "Gauntlet root missing package.json: $gauntlet_root"
  reject_mount_source "Gauntlet root" "$gauntlet_root"
}

if [[ "$env_file_explicit" == true ]]; then
  [[ -f "$env_file" ]] || die "env file does not exist: $env_file"
  [[ -r "$env_file" ]] || die "env file is not readable: $env_file"
  env_file=$(physical_file "$env_file")
else
  if [[ -f "$evals_root/.env.container" ]]; then
    env_file="$evals_root/.env.container"
  elif [[ -f "$evals_root/.env" ]]; then
    env_file="$evals_root/.env"
  fi
fi

validate_auth_dir() {
  local label dir
  label=$1
  dir=$2
  [[ -d "$dir" ]] || die "$label auth directory does not exist: $dir"
}

reject_mount_source() {
  local label source
  label=$1
  source=$2
  [[ "$source" != *","* ]] || die "$label path contains a comma, which Docker --mount cannot parse: $source"
}

if [[ "$auth_codex_explicit" == true ]]; then
  validate_auth_dir codex "$auth_codex"
  auth_codex=$(physical_dir "$auth_codex")
elif [[ "$no_default_auth" != true && -d "$HOME/.codex" ]]; then
  auth_codex=$(physical_dir "$HOME/.codex")
fi

if [[ "$auth_gemini_explicit" == true ]]; then
  validate_auth_dir gemini "$auth_gemini"
  auth_gemini=$(physical_dir "$auth_gemini")
elif [[ "$no_default_auth" != true && -d "$HOME/.gemini" ]]; then
  auth_gemini=$(physical_dir "$HOME/.gemini")
fi

if [[ "$auth_kimi_explicit" == true ]]; then
  validate_auth_dir kimi "$auth_kimi"
  auth_kimi=$(physical_dir "$auth_kimi")
elif [[ "$no_default_auth" != true && -d "$HOME/.kimi-code" ]]; then
  auth_kimi=$(physical_dir "$HOME/.kimi-code")
fi

if [[ "$auth_pi_explicit" == true ]]; then
  validate_auth_dir pi "$auth_pi"
  auth_pi=$(physical_dir "$auth_pi")
elif [[ "$no_default_auth" != true && -d "$HOME/.pi" ]]; then
  auth_pi=$(physical_dir "$HOME/.pi")
fi

reject_mount_source "evals root" "$evals_root"
reject_mount_source "Superpowers root" "$superpowers_root"
if [[ -n "$env_file" ]]; then
  reject_mount_source "env file" "$env_file"
fi
if [[ -n "$auth_codex" ]]; then
  reject_mount_source "codex auth" "$auth_codex"
fi
if [[ -n "$auth_gemini" ]]; then
  reject_mount_source "gemini auth" "$auth_gemini"
fi
if [[ -n "$auth_kimi" ]]; then
  reject_mount_source "kimi auth" "$auth_kimi"
fi
if [[ -n "$auth_pi" ]]; then
  reject_mount_source "pi auth" "$auth_pi"
fi

container_exists() {
  docker container inspect "$container_name" >/dev/null 2>&1
}

container_running() {
  [[ "$(docker container inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null)" == true ]]
}

mount_config_explicit() {
  [[ "$superpowers_root_explicit" == true \
    || "$env_file_explicit" == true \
    || "$auth_codex_explicit" == true \
    || "$auth_gemini_explicit" == true \
    || "$auth_kimi_explicit" == true \
    || "$auth_pi_explicit" == true \
    || "$no_default_auth" == true ]]
}

ensure_private_results_root() {
  mkdir -p "$evals_root/results"
  chmod 0700 "$evals_root/results"
}

# Create and remove the host-visible results probe for one exec TARGET
# (the configured container name in legacy mode, the immutable captured id
# in scoped mode). Returns 0 on success, 1 when the in-container probe
# fails, 2 when the probe file is not host-visible; the caller decides how
# to fail.
run_results_probe() {
  local target=$1
  local cleanup_probe host_probe_path probe probe_name
  ensure_private_results_root
  probe_name=".evals-container-probe.$$.$RANDOM"
  host_probe_path="$evals_root/results/$probe_name"
  probe='set -euo pipefail
results_dir=/workspace/evals/results
test -d "$results_dir"
test -w "$results_dir"
: > "$results_dir/'"$probe_name"'"'
  cleanup_probe='rm -f /workspace/evals/results/'"$probe_name"

  if ! docker exec "$target" bash -lc "$probe"; then
    return 1
  fi

  if [[ ! -f "$host_probe_path" ]]; then
    docker exec "$target" bash -lc "$cleanup_probe" >/dev/null 2>&1 || true
    return 2
  fi

  rm -f "$host_probe_path" || true
}

probe_results_mount() {
  local probe_status=0
  run_results_probe "$container_name" || probe_status=$?
  if [[ "$probe_status" == 1 ]]; then
    die "results directory is not usable at /workspace/evals/results"
  fi
  if [[ "$probe_status" == 2 ]]; then
    die "results directory is not host-visible at /workspace/evals/results"
  fi
}

# Scoped up: the results-mount probe runs against the immutable captured
# id. If it fails, roll back exactly that captured container — a replacement
# under the configured name is never stopped — retaining the original
# failure and appending any rollback failure without secret values.
scoped_probe_with_rollback() {
  local target=$1
  local probe_status=0
  run_results_probe "$target" || probe_status=$?
  if [[ "$probe_status" != 0 ]]; then
    if ! docker rm -f "$target" >/dev/null 2>&1; then
      die "scoped up failed its results-mount probe at /workspace/evals/results and rollback of container $target also failed"
    fi
    die "scoped up failed its results-mount probe at /workspace/evals/results; rolled back container $target"
  fi
}

# Roll back exactly one captured container id, preserving the original
# failure reason and appending a rollback failure without secret values.
scoped_rollback_or_die() {
  local target=$1 reason=$2
  if ! docker rm -f "$target" >/dev/null 2>&1; then
    die "scoped up $reason; rollback of container $target also failed"
  fi
  die "scoped up $reason; rolled back container $target"
}

run_up() {
  ensure_private_results_root
  local container_home=/workspace/evals/results/.container-home
  local container_cache_home="$container_home/.cache"
  local container_config_home="$container_home/.config"
  local container_state_home="$container_home/.local/state"
  local runtime_dir="$evals_root/results/.container-runtime"
  local passwd_file="$runtime_dir/passwd"
  local group_file="$runtime_dir/group"

  if container_exists; then
    if mount_config_explicit; then
      die "$container_name already exists; run scripts/evals-container down before changing mounts or credentials"
    fi

    if container_running; then
      printf '%s\n' "$container_name"
      return 0
    fi

    docker start "$container_name"
    return 0
  fi

  local mounts=()
  add_bind_mount() {
    local source=$1
    local target=$2
    local mode=${3:-}
    mounts+=(--mount "type=bind,source=$source,target=$target$mode")
  }

  # Host-side provenance override (queue-campaign item 22 / PRI-2494): resolve
  # superpowers_root's rev and dirty flag out here, where a linked worktree's
  # `.git` gitdir pointer still resolves into its primary checkout, and hand
  # them into the container as the authoritative provenance for
  # src/runner/provenance.ts. The equivalent in-container `git -C
  # /workspace/superpowers ...` fails for a linked worktree, since only
  # superpowers_root itself gets bind-mounted -- the primary checkout its
  # gitdir pointer resolves into does not. Best-effort: a resolution failure
  # (e.g. superpowers_root is not a git repo) just omits the env var, and
  # provenance capture falls back to its in-container probe.
  local provenance_env=()
  local superpowers_rev
  superpowers_rev=$(git -C "$superpowers_root" rev-parse HEAD 2>/dev/null || true)
  if [[ -n "$superpowers_rev" ]]; then
    provenance_env+=(--env "QUORUM_SUPERPOWERS_REV=$superpowers_rev")
    local superpowers_status
    if superpowers_status=$(git -C "$superpowers_root" status --porcelain 2>/dev/null); then
      if [[ -n "$superpowers_status" ]]; then
        provenance_env+=(--env "QUORUM_SUPERPOWERS_DIRTY=true")
      else
        provenance_env+=(--env "QUORUM_SUPERPOWERS_DIRTY=false")
      fi
    fi
  fi

  mkdir -p "$runtime_dir"
  {
    printf 'root:x:0:0:root:/root:/bin/bash\n'
    printf 'evals:x:%s:%s:Superpowers Evals:%s:/bin/bash\n' "$(id -u)" "$(id -g)" "$container_home"
  } > "$passwd_file"
  {
    printf 'root:x:0:\n'
    printf 'evals:x:%s:\n' "$(id -g)"
  } > "$group_file"
  chmod 0644 "$passwd_file" "$group_file"

  add_bind_mount "$evals_root" /workspace/evals
  add_bind_mount "$superpowers_root" /workspace/superpowers
  add_bind_mount "$evals_root/results" /workspace/evals/results
  add_bind_mount "$passwd_file" /etc/passwd ",readonly"
  add_bind_mount "$group_file" /etc/group ",readonly"

  if [[ -n "$env_file" ]]; then
    add_bind_mount "$env_file" /run/evals/credentials.env ",readonly"
  fi
  if [[ -n "$auth_codex" ]]; then
    add_bind_mount "$auth_codex" /auth/codex ",readonly"
  fi
  if [[ -n "$auth_gemini" ]]; then
    add_bind_mount "$auth_gemini" /auth/gemini ",readonly"
  fi
  if [[ -n "$auth_kimi" ]]; then
    add_bind_mount "$auth_kimi" /auth/kimi-code ",readonly"
  fi
  if [[ -n "$auth_pi" ]]; then
    add_bind_mount "$auth_pi" /auth/pi ",readonly"
  fi

  # --init runs tini as PID 1 so orphaned children (e.g. a run-all child whose
  # parent was killed before it could SIGINT them) are reaped instead of piling
  # up as <defunct> zombies; the bare `sleep infinity` PID 1 never reaps.
  local run_args=(
    -d
    --init
    --name "$container_name"
    --user "$(id -u):$(id -g)"
    --workdir /workspace/evals
    --env "HOME=$container_home"
    --env "XDG_CACHE_HOME=$container_cache_home"
    --env "XDG_CONFIG_HOME=$container_config_home"
    --env "XDG_STATE_HOME=$container_state_home"
    --env "TMPDIR=/tmp"
  )
  run_args+=("${provenance_env[@]+"${provenance_env[@]}"}")
  run_args+=("${mounts[@]}")
  local cidfile=""
  if [[ "$no_default_auth" == true ]]; then
    # Scoped up: docker itself records the created container's full id in a
    # PRIVATE cidfile, and that file is the rollback AUTHORITY. The cidfile
    # option is created and appended BEFORE the image tag: `docker run`
    # treats every argument after the image as the container command, so a
    # cidfile appended after it would be ignored as an option and shipped to
    # the container command instead. stdout is cross-checked as a full
    # 64-hex Docker id: blank, multi-token, name-like/malformed, or
    # mismatching stdout still rolls back exactly the cidfile id — never the
    # configured name. The probe and the printed id also use that id; a
    # later name lookup is never blessed.
    local authority_id stdout_id reason full_id_re
    full_id_re='^[0-9a-f]{64}$'
    cidfile=$(mktemp "${TMPDIR:-/tmp}/evals-container-cid.XXXXXXXX") \
      || die "could not create a private cidfile for $container_name"
    run_args+=(--cidfile "$cidfile")
  fi
  run_args+=(
    "$image_tag"
    bash -lc 'mkdir -p "$HOME" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME" && exec sleep infinity'
  )

  if [[ "$no_default_auth" == true ]]; then
    if ! stdout_id=$(docker run "${run_args[@]}"); then
      rm -f "$cidfile"
      die "docker run failed for $container_name"
    fi
    authority_id=$(cat "$cidfile" 2>/dev/null || true)
    rm -f "$cidfile"
    if ! [[ "$authority_id" =~ $full_id_re ]]; then
      # The cidfile is unusable (docker contract violation); stdout below is
      # the only rollback candidate and is validated before any use.
      authority_id=""
    fi
    # Command substitution strips trailing newlines; trim any other
    # surrounding whitespace before validating the printed id.
    stdout_id="${stdout_id#"${stdout_id%%[![:space:]]*}"}"
    stdout_id="${stdout_id%"${stdout_id##*[![:space:]]}"}"
    reason=""
    if [[ -z "$stdout_id" ]]; then
      reason="received no container id on stdout"
    elif [[ "$stdout_id" == *[[:space:]]* ]]; then
      reason="received multiple tokens on stdout instead of one container id"
    elif ! [[ "$stdout_id" =~ $full_id_re ]]; then
      reason="received a malformed container id on stdout (expected a full 64-hex docker id)"
    elif [[ -z "$authority_id" ]]; then
      authority_id="$stdout_id"
    elif [[ "$stdout_id" != "$authority_id" ]]; then
      reason="stdout container id does not match the cidfile container id"
    fi
    if [[ -n "$reason" ]]; then
      if [[ -z "$authority_id" ]]; then
        die "scoped up $reason for $container_name; no rollback target is known"
      fi
      scoped_rollback_or_die "$authority_id" "$reason for $container_name"
    fi
    scoped_probe_with_rollback "$authority_id"
    printf '%s\n' "$authority_id"
    return 0
  fi

  docker run "${run_args[@]}"
}

case "$command" in
  build)
    resolve_gauntlet_root
    docker build \
      --build-context "gauntlet=$gauntlet_root" \
      -t "$image_tag" \
      -f "$evals_root/container/Dockerfile" \
      "$evals_root"
    ;;
  up)
    run_up
    ;;
  down)
    if container_exists; then
      if container_running; then
        docker stop "$container_name"
      fi
      docker rm "$container_name"
    else
      printf '%s: missing\n' "$container_name"
    fi
    ;;
  status)
    if container_exists; then
      if container_running; then
        printf '%s: exists, running\n' "$container_name"
      else
        printf '%s: exists, stopped\n' "$container_name"
      fi
    else
      printf '%s: missing\n' "$container_name"
    fi
    ;;
  shell)
    docker exec -it "$container_name" bash
    ;;
  exec)
    [[ $# -gt 0 ]] || die "missing command for exec"
    if [[ -n "$expected_container_id" ]]; then
      # Scoped exec: require the configured NAME to resolve to the expected
      # immutable id right now, then target that id directly. No bundle
      # rediscovery, no mount args, no exec-time results probe (scoped up
      # already probed against this exact id).
      current_id=$(docker container inspect -f '{{.Id}}' "$container_name") \
        || die "configured container $container_name is not inspectable; refusing to exec against expected container id"
      if [[ "$current_id" != "$expected_container_id" ]]; then
        die "configured container $container_name is a replacement (current id $current_id does not match the expected id); refusing to exec into it"
      fi
      if [[ -n "$exec_env_file" ]]; then
        exec docker exec --env-file "$exec_env_file" "$expected_container_id" "$@"
      fi
      exec docker exec "$expected_container_id" "$@"
    fi
    if [[ "${1:-}" == "quorum" ]]; then
      probe_results_mount
    fi
    docker exec "$container_name" "$@"
    ;;
esac
